# =============================================================================
# CAMEL Annotation — PRODUCTION 56K WAVE: acegpt-70b
# =============================================================================
# Model:   FreedomIntelligence/AceGPT-v2-70B-chat
# Origin:  Arabic (KAUST, Saudi Arabia)
# Cluster: OrangeGrid (single A100 80GB, TP=1, config3.yaml)
# Corpus:  57 chunks (1000 texts/chunk, final chunk 796) = 56,796 texts
#
# Hand-authored from the validated test_job_og.sub / batch_qwen2.5-72b.sub recipe
# (NOT generate_batch_jobs.py, whose orangegrid branch emits an off-recipe
# Apophis-style skeleton). Uses the template wrapper.sh (CAMEL_CONFIG override +
# CUDA UUID->integer conversion); model, TP, and config come from the
# environment ClassAd, not a baked --model.
#
# UNVALIDATED — no Apophis or OG characterization run yet for this model.
# Do NOT submit for a full wave until validated (chunk_000 test first).
# --trust-remote-code already present in camel_annotate_hpc.py MODEL_OVERRIDES
# for this hf_name — no code-side gap here.
#
# SUBSET PROTOCOL — swap the chunk list without editing this recipe:
#   First (chunk_000 only, 1 job):   condor_submit batch_acegpt-70b.sub
#   Release rest (001..056, 56 jobs):
#       condor_submit -a 'CHUNKLIST = chunklist_rest.txt' batch_acegpt-70b.sub
#   (default below is chunklist_first.txt; -a overrides it right before the queue)
#
# Monitor: condor_q $USER ; watch -n 30 'ls results_acegpt-70b/*.feather | wc -l'
# =============================================================================

# --- swappable chunk list (default = first; override with -a for the rest) ---
CHUNKLIST = chunklist_first.txt

executable   = wrapper.sh
transfer_executable = false
initialdir   = /home/szkhan/code_space3/hpc

# Run-versioned provenance naming: nothing ever overwrites a prior run.
# Schema: <model_tag>_chunk<NNN>_<YYYYMMDD>_run<NNNN>_cl<Cluster>
# RUN_NO + SUBDATE are supplied once per wave by submit_wave.sh (-a macros);
# $(Cluster) + chunk<NNN> keep every file unique within the wave.
MODEL_TAG    = acegpt-70b
# Per-item derived paths (chunk_id supplied by the queue list, e.g. 000)
chunk_file   = chunks/test_chunk.feather
result_file  = results_acegpt-70b_gate/results_test.feather
job_name     = acegpt-70b_gate_test

arguments    = $(chunk_file) $(result_file)

output       = logs/$(job_name).out
error        = logs/$(job_name).err
log          = logs/$(job_name).log

# TWO A100 80GB on one node, TP=2. Unlike every other roster model, AceGPT-v2
# has NO AWQ/GPTQ/INT4 release (only GGUF), so it runs unquantized fp16:
# ~140GB of weights against 2x80GB = 160GB, i.e. ~144GB usable at gpu_util 0.90.
# That fits but leaves only ~4GB for KV cache, so expect thin batching and low
# throughput. If the gate shows starved batching, the fallback is on-the-fly
# --quantization fp8 on 2x L40S (sm_89 has native FP8; A100 sm_80 does not, so
# fp8 on A100 would be emulated and SLOWER than fp16).
request_gpus   = 2
+request_gpus = 2
request_cpus   = 8
request_memory = 64GB

# Pin to A100 80GB. TARGET.GPUs >= 2 is the proxy for "both A100s on the node free"
# (avoids GPU-memory contention when Condor slot bookkeeping diverges from nvidia-smi).
# CUDADeviceName is the correct attribute for HTCondor 9.8.0.
Requirements = (CUDADeviceName == "NVIDIA A100 80GB PCIe") && (TARGET.GPUs >= 2)

# Files on NFS home; no transfer needed. Do NOT add a when_to_transfer_output line.
should_transfer_files = NO

# wrapper.sh reads CAMEL_MODEL / CAMEL_TP / CAMEL_CONFIG from here.
# quantization left at wrapper.sh default (awq_marlin) — not set here.
# HF repo ids are case-sensitive: the published repo is "AceGPT-v2-70B-Chat"
# (capital C). The previous "-chat" spelling would have failed every job.
# CAMEL_QUANTIZATION=none makes camel_annotate_hpc.py omit --quantization so
# vLLM auto-detects fp16 from the model config; the wrapper.sh default
# (awq_marlin) would be a hard startup failure on unquantized weights.
environment = "HOME=/home/szkhan CAMEL_MODEL=FreedomIntelligence/AceGPT-v2-70B-Chat CAMEL_TP=2 CAMEL_CONFIG=config3.yaml CAMEL_QUANTIZATION=none HF_HOME=/home/szkhan/.cache/huggingface"

# Retry a failed chunk once (transient node issues); hold after that for inspection.
on_exit_hold = (ExitCode != 0)
periodic_release = (NumJobStarts < 2) && ((CurrentTime - EnteredCurrentStatus) > 300)

# Reclaim-protection: keep the job's claim across a brief disconnect (matches OG).
job_lease_duration = 14400

+wantsArgusNode = True
+JobBatchName = "camel-gate-acegpt-70b"

# One job per chunk id in the active chunk list.
queue 1
